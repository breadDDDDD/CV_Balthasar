# Copy to .env for local runs, or set these as Cloud Run environment variables.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3-flash-preview   # the only allow-listed model (app/guardrails.py)
# AI_MOCK=1                      # canned AI answers, no Gemini calls (free)
# ALLOWED_ORIGINS=http://localhost:5173
# AI_RATE_PER_MINUTE=8           # per client IP
# AI_RATE_PER_DAY=150            # per running instance
# AI_RATE_PER_IP_DAY=40          # per client IP
# RATE_PER_MINUTE=90             # all endpoints, per client IP
# ENFORCE_ORIGIN=1               # only ALLOWED_ORIGINS may call the API
# SESSION_SECRET=                # optional; signs AI session tokens
# AI_MAX_OUTPUT_TOKENS=4096
# MAX_UPLOAD_MB=5
