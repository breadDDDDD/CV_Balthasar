ullets { margin-top: 0; }\np, li { orphans: 2; widows: 2; }\n\n@media screen {\n  html { background: transparent; }\n  .page {\n    width: 210.0mm;\n    min-height: 297.0mm;\n    margin: 0 auto;\n    padding: 5.0mm;\n    background: #fff;\n  }\n}\n</style>\n</head>\n<body>\n<main class=\"page\">\n  <header class=\"cv-header\" data-id=\"header\"><h1 class=\"name\">  Spaced  Name </h1>    <p class=\"contacts\"><span class=\"contact\" data-id=\"ctc_x\">x@example.com</span></p>  </header>  <section class=\"section\" data-id=\"sec_exp\" data-type=\"experience\">    <h2 class=\"section-title\">Work</h2>    <div class=\"item\" data-id=\"itm_1\">      <div class=\"row\"><span class=\"title\">Company</span><span class=\"right date\">2020</span></div><p class=\"line\" data-id=\"lin_1\">Line keeps its period.</p>      <ul class=\"bullets\"><li data-id=\"blt_1\">Increased revenue by 25% in 2021</li><li data-id=\"blt_2\">Grew the team to 12 people</li><li data-id=\"blt_3\">Managed vendors</li><li data-id=\"blt_4\">Designed it..</li><li data-id=\"blt_5\">Short one</li></ul>    </div>  </section></main>\n</body>\n</html>",
